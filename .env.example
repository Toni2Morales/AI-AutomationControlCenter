# AI Automation Control Center - Plantilla de variables de entorno

# Copia este archivo como .env para usarlo en tu entorno local
# NO añadas valores reales ni credenciales a este archivo

# Entorno general
APP_ENV=dev
APP_NAME=ai-automation-control-center
TZ=Europe/Madrid

# Backend (FastAPI)
# Uvicorn escucha en 0.0.0.0:8000 dentro del contenedor.
# El puerto se publica únicamente en 127.0.0.1 en Windows.
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Base de datos PostgreSQL
# POSTGRES_HOST y POSTGRES_PORT son valores de referencia para herramientas
# ejecutadas en Windows; no construyen DATABASE_URL automáticamente.
# DATABASE_URL es la conexión interna con host postgres. Docker Compose
# construye su propia DATABASE_URL para el backend a partir de POSTGRES_*.
# Con la implementación actual, POSTGRES_PASSWORD debe usar solo caracteres
# URL-safe: letras ASCII, dígitos, guion bajo (_) y guion (-). Compose interpola
# la contraseña directamente en DATABASE_URL; los caracteres reservados pueden
# alterar la URL. Esta restricción es de la configuración actual, no de PostgreSQL.
# Para Alembic desde Windows, sobrescribe DATABASE_URL en la sesión de PowerShell
# con el host 127.0.0.1 (ver README).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aacc_db
POSTGRES_USER=aacc_user
POSTGRES_PASSWORD=CAMBIAR_VALOR
DATABASE_URL=postgresql+psycopg://aacc_user:CAMBIAR_VALOR@postgres:5432/aacc_db

# Ollama (IA local)
# La imagen oficial está fijada a la versión validada en compose.yaml.
OLLAMA_IMAGE=ollama/ollama:0.40.15
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=120

# n8n (automatización local)
# Obligatoria: genera una clave aleatoria y única para cifrar credenciales.
# No uses el marcador de ejemplo ni una clave compartida.
# PowerShell:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $key = New-Object byte[] 32
#   $rng.GetBytes($key)
#   [Convert]::ToBase64String($key)
N8N_HOST=127.0.0.1
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
WEBHOOK_URL=http://127.0.0.1:5678/
# URL interna prevista para que FastAPI llame a n8n.
N8N_BASE_URL=http://n8n:5678
# URL interna prevista para que n8n llame a FastAPI.
# Todavía no se inyecta en el contenedor de n8n ni se usa en la integración funcional.
N8N_CALLBACK_BASE_URL=http://backend:8000

# Nivel de registro de n8n (se aplica como N8N_LOG_LEVEL).
LOG_LEVEL=info
